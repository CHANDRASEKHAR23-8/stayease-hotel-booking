# =====================================================================
# STAYEASE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local settings.
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stayease_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=super_secret_stayease_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_stayease_refresh_key_2026_change_in_prod
JWT_REFRESH_EXPIRES_IN=30d

# CORS and Frontends
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# File Storage Configuration (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
MAX_FILE_SIZE_MB=5

# Payment Gateway Interface (mock, stripe, paypal)
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=whsec_stayease_secure_webhook_secret_key_84920
